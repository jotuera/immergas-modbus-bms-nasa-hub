{#- Immergas Magis Pro Combo DFT HUB - dashboard generator (Jinja, Home Assistant)
    Usage: Developer tools -> Template -> paste this WHOLE file -> copy the result from the right-hand side
    -> Settings -> Dashboards -> Add dashboard (new, empty) -> open it -> pencil -> three dots -> Raw configuration
    editor -> paste the result -> Save.
    Entities are looked up by NAME ("Immergas Hub - COP"), not by entity_id, so the dashboard is correct whatever the
    device name, the area and the entity-id format in HA. Works with the Polish and the English entity names; titles and
    labels follow the hub language. A missing entity shows up as "sensor.missing_<name>". -#}
{%- set ns = namespace(dev=none, d={}, en=false) -%}
{%- for e in integration_entities('esphome') if ns.dev is none and (state_attr(e, 'friendly_name') or '') is string -%}
  {%- set fn = state_attr(e, 'friendly_name') -%}
  {%- if fn.endswith('Immergas Hub - Stan pracy') or fn.endswith('Immergas Hub - Operating state') -%}
    {%- set ns.dev = device_id(e) -%}
    {%- set ns.en = fn.endswith('Operating state') -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.dev is none -%}
# ERROR: no device with the entity "Immergas Hub - Operating state" / "Immergas Hub - Stan pracy". Is the hub added to HA (ESPHome integration)?
{%- else -%}
{%- set dn = device_attr(ns.dev, 'name_by_user') or device_attr(ns.dev, 'name') -%}
{%- for e in device_entities(ns.dev) -%}
  {%- set fn = state_attr(e, 'friendly_name') or '' -%}
  {%- set ns.d = dict(ns.d, **{(fn[dn | length + 1:] if fn.startswith(dn ~ ' ') else fn): e}) -%}
{%- endfor -%}
{%- macro x(pl, en) -%}{{ ns.d.get(en if ns.en else pl, ns.d.get(pl if ns.en else en, 'sensor.missing_' ~ ((en if ns.en else pl) | slugify))) }}{%- endmacro -%}
{%- macro t(pl, en) -%}{{ en if ns.en else pl }}{%- endmacro -%}
{%- macro row(pl, en, lpl, len) %}          - entity: {{ x(pl, en) }}
            name: {{ t(lpl, len) }}{% endmacro -%}
# Generated for device "{{ dn }}" ({{ ns.d | length }} entities, {{ t('PL', 'EN') }}) - {{ now().strftime('%Y-%m-%d %H:%M') }}
